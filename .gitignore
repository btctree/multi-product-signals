# price cache is large + regenerated by CI; keep the repo lean
data/prices/
data/*.csv
# SEC EPS facts for E1, fetched fresh by engine/sec_fetch.py in each CI run
# (data/sec_cik.json, the CIK map it reads, IS committed)
data/sec/
__pycache__/
*.pyc
.DS_Store
*.xlsx
reports/
# keep: data/universe.json, data/positions.json, data/trade_log.json, docs/
!data/universe.json

# contains secrets (GitHub PAT, Telegram ID) - never commit
Multi-Market System.txt

# dashboard data is regenerated by CI before every deploy - never commit
data/*.json.tmp*
data/*.jsonl.tmp*
docs/products/
docs/data.json
docs/sim_lines.json
# local-preview copies of files the VM publishes under data/ - the page
# falls back to a same-directory copy when raw.githubusercontent is not
# reachable, which is how the dashboard is previewed offline
docs/netliq_history.json
docs/day_parts.json

# bot runtime state (per-VM, not shared)
execution/state.json
# save_state's temp file (write, fsync, os.replace): one left behind by a kill
# mid-save must not show up as untracked on the VM
execution/state.json.tmp
execution/*.log

# Claude chat transcripts — contain secrets (PATs) and private detail
_chat_backup/

# IB OAuth key material - NEVER commit (public keys here today, private keys must never land in the repo)
IB KEY/
oauth_keys/
*.pem
